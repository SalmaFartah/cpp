#include <iostream>
#include <string>

class Dog
{
private:
	// 1. Data Member (Variable)
	std::string name;        // holds data for each dog
	int age;

	// 2. Static Data Member (Shared Variable)
	static int dogCount; // shared by ALL dogs, not one per dog

public:
	// 3. Constructor - runs when dog is created
	Dog(std::string n, int a);

	// 4. Destructor - runs when dog is destroyed
	~Dog();

	// 5. Member Function (Method) - action the dog can do
	void bark()
	{
		std::cout << name << " says Woof!\n";
	}

	// 6. Static Member Function - works on shared data
	static int getDogCount()
	{
		return dogCount;  // can only access static members
	}

	// 7. Friend Function - not part of dog, but can see private data
	friend void showAge(Dog d); // declaration

	// 8. Nested Type - a type defined inside the class
	enum Size { Small, Medium, Large };
	Size size;
};

//define constructor outside the class
Dog::Dog(std::string n, int a)
{
	name = n;
	age = a;
	dogCount++;  // increase total count
	std::cout << "A new dog is born!\n";
}

//define destructor outside the class
Dog::~Dog()
{
	std::cout << name << " is going away...\n";
	dogCount--;
}

// Define the static member outside the class
int Dog::dogCount = 0;  // starts at 0

// 7. Friend Function Definition (defined outside)
void showAge(Dog d)
{
	std::cout << "Dog's age is: " << d.age << "\n";  // can access private 'age'
}

// Main function to use the class
int main() {
	Dog dog1("Buddy", 3);  // constructor runs
	dog1.size = Dog::Medium;
	dog1.bark();           // call member function
	showAge(dog1);         // friend function calls

	std::cout << "Total dogs: " << Dog::getDogCount() << "\n";  // static function

	return 0;
	// dog1 destroyed here → destructor runs
}  
